# Copy to .env and fill in. NEVER commit a real .env to GitHub.
OPENAI_API_KEY=
# Local defaults (docker-compose overrides these inside containers):
MONGO_URI=mongodb://localhost:27017/print247_chatbot
QDRANT_URL=http://localhost:6333
# Models: mini answers, nano does small jobs (language/slot extraction).
CHAT_MODEL=gpt-5-mini
HELPER_MODEL=gpt-5-nano
EMBEDDING_MODEL=text-embedding-3-small
